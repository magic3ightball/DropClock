            "value": "하루 시간대"
          }
        }
      }
    },
    "Doses are spread evenly between your first and last drop.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初と最後の点眼の間に均等に配置されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 점안과 마지막 점안 사이에 고르게 배치돼요."
          }
        }
      }
    },
    "DropClock Full unlocked": {
      "localizations": {
        "ja": {
