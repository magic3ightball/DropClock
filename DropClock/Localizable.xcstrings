    "Add the eye drops your doctor prescribed in the Drops tab.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「目薬」タブで処方された目薬を追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘안약’ 탭에서 처방받은 안약을 추가하세요."
          }
        }
      }
    },
    "Nothing scheduled today": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の予定はありません"
