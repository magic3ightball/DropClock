    },
    "DropClock is a reminder tool. Always follow your doctor's instructions.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DropClockはリマインダーです。必ず医師の指示に従ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DropClock은 알림 도구예요. 항상 의사 지시를 따르세요."
          }
        }
      }
    },
    "DropClock Full": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DropClock フル版"
          }
        },
        "ko": {
